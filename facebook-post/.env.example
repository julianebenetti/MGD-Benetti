# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# ID da Página do Facebook (Configurações da Página > Transparência da Página > ID)
FB_PAGE_ID=
# Token de acesso DA PÁGINA (veja o README, passo 3)
FB_PAGE_TOKEN=
# Versão da Graph API (confirme a vigente em developers.facebook.com/docs/graph-api/changelog)
FB_GRAPH_VERSION=v25.0
# Máximo de posts por dia (comece baixo: 2 a 5)
FB_LIMITE_DIA=3
# Segundos de espera entre postar e comentar
FB_ESPERA_COMENTARIO_SEG=20
# Modelos (use \n para quebra de linha). {produto} e {link} são preenchidos sozinhos
# FB_MODELO_LEGENDA={produto}\n\n🛒 Compre aqui: {link}\n\n⚠️ Link de afiliado. Preço e estoque podem mudar.
# FB_MODELO_COMENTARIO=🛒 Compre aqui: {link}

# ── Bot do Telegram (abas por Página) ──
# Token do bot (crie no @BotFather com /newbot). NUNCA suba o .env para o GitHub.
TG_BOT_TOKEN=
# ID do grupo (rode: python3 bot_telegram.py --descobrir-chat)
TG_CHAT_ID=
# (opcional) IDs de Telegram que podem usar o bot, separados por vírgula. Vazio = qualquer membro do grupo
TG_USUARIOS=
# "sim" = posta de verdade no Facebook. Qualquer outra coisa = MODO TESTE (só simula)
BOT_ENVIAR=nao
# Limites (valem para cada Página; dá para mudar por Página no config-bot.json)
BOT_LIMITE_DIA=3
BOT_INTERVALO_MIN=120
BOT_JANELA=8-22
BOT_MAX_FILA=30
BOT_MAX_TENTATIVAS=3
BOT_PAUSA_HORAS=6
# Token do USUÁRIO DO SISTEMA (só para rodar obter-tokens-paginas.js uma vez; depois pode apagar)
FB_SYSTEM_TOKEN=

# ── Mais posts por dia (aquecimento) ──
# Sobe o limite diário aos poucos: começa em BOT_LIMITE_DIA e aumenta BOT_AUMENTO_DIA por dia até BOT_LIMITE_MAX (0 = desligado)
BOT_AUMENTO_DIA=0
BOT_LIMITE_MAX=3

# ── Link rastreável da Shopee ──
# "sim" converte links da Shopee com sub-ID facebook-<sigla>-<produto> e busca o nome do produto
BOT_CONVERTER_SHOPEE=sim
# Chaves da API de afiliados: se não estiverem aqui, o robô lê (só leitura) do .env do robô da Shopee Vídeo
# SHOPEE_ENV=/opt/shopee-video/shopee-video-automation/.env
# Espera antes de comentar em vídeo (ele demora a processar)
FB_ESPERA_VIDEO_SEG=30

# ── Ritmo de uma postagem por hora (por Página) ──
# BOT_JANELA=6-23  BOT_INTERVALO_MIN=60  BOT_LIMITE_DIA=17  BOT_MAX_FILA=80
# Depois de cada post o robô soma uma folga aleatória de 0 a BOT_VARIACAO_MIN minutos ao intervalo, para o ritmo não ser exato.
BOT_VARIACAO_MIN=10
