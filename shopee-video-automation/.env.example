# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004298071088
# Preenchidos por: python setup_topics.py
TELEGRAM_TOPIC_ENVIOS=
TELEGRAM_TOPIC_EDITADOS=
TELEGRAM_TOPIC_AGENDA=
TELEGRAM_TOPIC_POSTADOS=

# Shopee Affiliate Open API (painel de afiliados > Open API)
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Abrir páginas da Shopee pelo VPS (variações, links de vídeo). Desligado: a Shopee bloqueia como robô
# e as tentativas ficam associadas à conta. As variações vêm do print que você manda em Editados.
SHOPEE_ACESSAR_PAGINAS=nao
# auto = Chromium normal numa tela virtual (menos bloqueio da Shopee) | headless | visivel
SHOPEE_BROWSER_MODE=auto

# OpenAI (a mesma chave do Central Post serve)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Links por vídeo (original + outros vendedores)
LINKS_POR_VIDEO=3

# Agenda
AGENDA_POSTS_POR_DIA=10
AGENDA_INICIO=9
AGENDA_FIM=22
AGENDA_TIMEZONE=America/Sao_Paulo

# Pasta dos vídeos prontos
VIDEOS_OUTPUT_DIR=processed_videos

# Segundos que a capa aparece na abertura do vídeo final
CAPA_SEGUNDOS=1
