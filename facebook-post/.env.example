# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# ID da Página do Facebook (Configurações da Página > Transparência da Página > ID)
FB_PAGE_ID=
# Token de acesso DA PÁGINA (veja o README, passo 3)
FB_PAGE_TOKEN=
# Versão da Graph API (confirme a vigente em developers.facebook.com/docs/graph-api/changelog)
FB_GRAPH_VERSION=v24.0
# Máximo de posts por dia (comece baixo: 2 a 5)
FB_LIMITE_DIA=3
# Segundos de espera entre postar e comentar
FB_ESPERA_COMENTARIO_SEG=20
# Modelos (use \n para quebra de linha). {produto} e {link} são preenchidos sozinhos
# FB_MODELO_LEGENDA={produto}\n\n🛒 Compre aqui: {link}\n\n⚠️ Link de afiliado. Preço e estoque podem mudar.
# FB_MODELO_COMENTARIO=🛒 Compre aqui: {link}
