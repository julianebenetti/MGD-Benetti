# Copie para .env e preencha. Depois: set -a; source .env; set +a

# Mesmas chaves que o shopee-sync.py ja usa
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Bot criado no @BotFather e adicionado ao grupo dos videos.
# Desligue o privacy mode em /setprivacy, senao o bot nao ve as mensagens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GRUPO_ID=

# Opcionais
# FFMPEG_BIN=/usr/bin/ffmpeg
# FONTE_MARCA=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
