# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004298071088
# Preenchidos por: python setup_topics.py
TELEGRAM_TOPIC_ENVIOS=
TELEGRAM_TOPIC_EDITADOS=
TELEGRAM_TOPIC_AGENDA=
TELEGRAM_TOPIC_POSTADOS=

# Shopee Affiliate Open API (painel de afiliados > Open API)
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Abrir páginas da Shopee pelo VPS (variações, links de vídeo). Desligado: a Shopee bloqueia como robô
# e as tentativas ficam associadas à conta. As variações vêm do print que você manda em Editados.
SHOPEE_ACESSAR_PAGINAS=nao
# Avaliações para as narrações dos prompts: chegam pela extensão do Chrome (/extensao no Telegram); o robô não
# acessa a Shopee. A chave é criada sozinha pelo instalar.sh. AVALIACOES_URL só se o endereço automático não servir.
AVALIACOES_CHAVE=
AVALIACOES_PORTA=8787
AVALIACOES_URL=
# auto = Chromium normal numa tela virtual (menos bloqueio da Shopee) | headless | visivel
SHOPEE_BROWSER_MODE=auto

# OpenAI (a mesma chave do Central Post serve)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Links por vídeo (original + outros vendedores)
LINKS_POR_VIDEO=5

# Agenda
AGENDA_POSTS_POR_DIA=10
AGENDA_INICIO=9
AGENDA_FIM=22
AGENDA_TIMEZONE=America/Sao_Paulo
# Intervalo entre um post e o próximo da fila (minutos)
AGENDA_INTERVALO_MIN=60
AGENDA_INTERVALO_MAX=120

# Pasta dos vídeos prontos
VIDEOS_OUTPUT_DIR=processed_videos

# Segundos que a capa aparece na abertura do vídeo final
CAPA_SEGUNDOS=1

# LiA (@Liaautomacao_bot), que posta no Shopee Video. Bot não fala com bot: o envio sai pela sua
# conta do Telegram. Pegue api_id e api_hash em my.telegram.org → API development tools e depois
# rode uma vez:  .venv/bin/python lia_login.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LIA_BOT=@Liaautomacao_bot
# Quando mandar: agenda (no horário agendado) | aprovar (logo ao aprovar) | nao (desligado)
LIA_ENVIAR=agenda
# postar | rascunho
LIA_MODO=postar
# Legenda: nossa (descrição + hashtags do robô; na LiA, /opcoes → Legenda Manual) | ia (só links, a LiA escreve)
LIA_LEGENDA=nossa
# Vídeo feito por IA (YouTube Create, app da LiA…): sim = #ia (aviso + rótulo de IA na Shopee) | nao = #semia
LIA_VIDEO_IA=sim
# Tocar em Publicar sozinho no resumo da LiA: sim | nao
LIA_PUBLICAR_AUTO=sim

# Segundos finais do vídeo com a CTA ("Adicione já ao carrinho!"...)
CTA_SEGUNDOS=5

# Horário do relatório diário em 📊 Relatório (também dá para pedir com /relatorio)
RELATORIO_HORA=22:30

# Conexões só por IPv4 (resolve "Telegram sem resposta" em VPS com IPv6 instável): sim | nao
FORCAR_IPV4=sim

# Horário da lista diária de ideias em 💡 Ideias (também dá para pedir com /sugestoes)
IDEIAS_HORA=07:30
# 💸 Preço acessível nas ideias: preço máximo e comissão mínima por venda (R$)
IDEIAS_PRECO_ACESSIVEL=60
IDEIAS_COMISSAO_ACESSIVEL=3
# Sem confirmação da LiA depois de tantas horas: o robô avisa na Agenda
LIA_ALERTA_HORAS=2

# Máximo de links que vão para a LiA por vídeo (o divulgado + os extras de maior comissão).
# A Shopee pune produtos "adicionais" ao anúncio vinculado: 1 = só o link do produto do vídeo (recomendado)
LIA_MAX_LINKS=1
# Aviso de venda nova em 📊 Relatório (confere a cada VENDAS_AVISO_MINUTOS): videos (só Shopee Vídeo) | todas | nao
VENDAS_AVISO=videos
VENDAS_AVISO_MINUTOS=60
# Logo do robô no vídeo e na capa: nao (padrão: o logo é habilitado direto na Shopee) | sim
LOGO_ROBO=nao
