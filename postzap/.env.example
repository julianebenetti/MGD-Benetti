# PostZap — copie para .env e preencha (nunca suba o .env para o GitHub)

# Senha para entrar no PostZap pelo navegador
POSTZAP_SENHA=
POSTZAP_PORTA=8790

# Garimpo (Supabase, só leitura da tabela garimpo_produtos)
SUPABASE_URL=https://tkxkrbdvcctoajuigvvv.supabase.co
# Vazia = usa a chave pública do garimpo-shopee.html
SUPABASE_KEY=

# Central Shopee Vídeo (banco do robô, aberto só para leitura)
CENTRAL_DB=/opt/shopee-video/shopee-video-automation/estado.db

# WhatsApp (Evolution API rodando no Docker deste VPS). A chave é criada pelo instalar.sh
EVOLUTION_PORTA=
EVOLUTION_URL=http://127.0.0.1:18080
EVOLUTION_KEY=
# Os 3 chips (admins dos grupos). Cada envio sorteia qual chip posta em cada grupo
EVOLUTION_INSTANCIAS=chip1,chip2,chip3

# Proteção contra ban
INTERVALO_MIN_SEG=90
INTERVALO_MAX_SEG=240
LIMITE_POSTS_DIA_POR_GRUPO=8
NAO_REPETIR_DIAS=7
COMISSAO_MIN=9

# Link curto com prévia (foto + título) — igual ao divulguei.app, mas no seu domínio
URL_PUBLICA=https://posts.descontoirresistivel.com.br/zap
TITULO_PREVIA=@descontoirresistivel
# Sub ID dos links de afiliado: no relatório da Shopee dá pra ver as vendas que vieram do WhatsApp
SUB_ID=postzap
# Amazon: sua tag de associada (ex.: pedritabambam-20). Todo link da Amazon sai com ela
AMAZON_TAG=
# Chaves da Shopee Affiliate (foto, preço atual, link). Vazias = usa as do robô do Shopee Vídeo (só leitura)
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
CENTRAL_ENV=/opt/shopee-video/shopee-video-automation/.env

# Conversa pelo WhatsApp: números (com DDD) que podem mandar links para os chips. Outros são ignorados
NUMEROS_AUTORIZADOS=
# Criado pelo instalar.sh (endereço secreto onde o WhatsApp avisa as mensagens recebidas)
WEBHOOK_SEGREDO=
# Chamada automática: vazia = usa a chave OpenAI do robô do Shopee Vídeo (só leitura)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Imagens bonitas pelo Google Gemini (chave grátis em aistudio.google.com → Get API key)
GEMINI_API_KEY=
